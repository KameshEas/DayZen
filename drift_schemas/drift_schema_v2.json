  "fixed_sql": [
    {
      "name": "tasks",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"tasks\" (\"id\" TEXT NOT NULL, \"title\" TEXT NOT NULL, \"start_hour\" INTEGER NOT NULL, \"start_minute\" INTEGER NOT NULL, \"end_hour\" INTEGER NOT NULL, \"end_minute\" INTEGER NOT NULL, \"priority\" TEXT NOT NULL, \"category\" TEXT NOT NULL, \"icon_code_point\" INTEGER NULL, \"subtitle\" TEXT NULL, \"is_completed\" INTEGER NOT NULL DEFAULT 0 CHECK (\"is_completed\" IN (0, 1)), \"status\" TEXT NOT NULL DEFAULT 'active', \"completed_at\" INTEGER NULL, \"rollover_count\" INTEGER NOT NULL DEFAULT 0, \"effort\" INTEGER NULL, \"original_date\" INTEGER NULL, \"date\" INTEGER NOT NULL, \"created_at\" INTEGER NOT NULL DEFAULT (CAST(strftime('%s', CURRENT_TIMESTAMP) AS INTEGER)), \"updated_at\" INTEGER NOT NULL DEFAULT (CAST(strftime('%s', CURRENT_TIMESTAMP) AS INTEGER)), \"dirty\" INTEGER NOT NULL DEFAULT 1 CHECK (\"dirty\" IN (0, 1)), \"deleted_at\" INTEGER NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "journal_entries",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"journal_entries\" (\"id\" TEXT NOT NULL, \"title\" TEXT NOT NULL, \"body\" TEXT NOT NULL, \"mood\" TEXT NOT NULL, \"timestamp\" INTEGER NOT NULL, \"accent_color_value\" INTEGER NULL, \"created_at\" INTEGER NOT NULL DEFAULT (CAST(strftime('%s', CURRENT_TIMESTAMP) AS INTEGER)), \"updated_at\" INTEGER NOT NULL DEFAULT (CAST(strftime('%s', CURRENT_TIMESTAMP) AS INTEGER)), \"dirty\" INTEGER NOT NULL DEFAULT 1 CHECK (\"dirty\" IN (0, 1)), \"deleted_at\" INTEGER NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "checkins",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"checkins\" (\"id\" TEXT NOT NULL, \"at\" INTEGER NOT NULL, \"energy\" INTEGER NOT NULL CHECK(\"energy\" BETWEEN 1 AND 5), \"mood\" TEXT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "day_closes",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"day_closes\" (\"date\" INTEGER NOT NULL, \"closed_at\" INTEGER NOT NULL, \"done\" INTEGER NOT NULL, \"carried\" INTEGER NOT NULL, \"released\" INTEGER NOT NULL, \"journal_entry_id\" TEXT NULL, PRIMARY KEY (\"date\"));"
        }
      ]
    },
    {
      "name": "rhythm_profile",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"rhythm_profile\" (\"bin\" INTEGER NOT NULL CHECK(\"bin\" BETWEEN 0 AND 23), \"value\" REAL NOT NULL, \"weight\" REAL NOT NULL, \"updated_at\" INTEGER NOT NULL, PRIMARY KEY (\"bin\"));"
        }
      ]
    },
    {
      "name": "counters",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"counters\" (\"key\" TEXT NOT NULL, \"value\" INTEGER NOT NULL DEFAULT 0, \"updated_at\" INTEGER NOT NULL, PRIMARY KEY (\"key\"));"
        }
      ]
    },
