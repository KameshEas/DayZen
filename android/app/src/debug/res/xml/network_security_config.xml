<?xml version="1.0" encoding="utf-8"?>
<!-- Debug builds only (src/debug). Lets the app reach a local API over plain
     HTTP through `adb reverse tcp:8000 tcp:<api-port>` (env/dev.json points at
     http://localhost:8000). Everything else stays HTTPS-only; release builds
     don't include this file and keep Android's default (no cleartext). -->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
